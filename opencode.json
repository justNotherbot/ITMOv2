{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "provider": {
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  }
}
